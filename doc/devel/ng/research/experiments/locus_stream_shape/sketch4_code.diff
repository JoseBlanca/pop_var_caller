+impl<T> SampleLocusObservationsIterator<T>
+where
+    T: Iterator<Item = Result<TypedRegion, TypedRegionError>>,
+{
+    /// **SKETCH.** [`Iterator::next`]'s block-shaped twin: drive the current region until
+    /// the block reaches its budget, taking the next region when one is drained. `false`
+    /// means the stream is over; the block may still hold loci.
+    ///
+    /// The block is **not** cleared here — the consumer owns it and decides when.
+    pub fn fill_block(&mut self) -> Result<bool, LocusGenerationError> {
+        if self.done {
+            return Ok(false);
+        }
+        loop {
+            match self.generators.next_block(&self.reads) {
+                Ok(true) => return Ok(true),
+                Err(error) => {
+                    self.done = true;
+                    return Err(error);
+                }
+                // A region can drain with the block already at its budget. Handing the
+                // block over then rather than starting the next region is what keeps the
+                // budget a bound rather than a suggestion.
+                Ok(false)
+                    if self
+                        .generators
+                        .block_sink_mut()
+                        .is_some_and(|sink| sink.is_full()) =>
+                {
+                    return Ok(true);
+                }
+                Ok(false) => match self.regions.next() {
+                    None => {
+                        self.done = true;
+                        return Ok(false);
+                    }
+                    Some(Err(error)) => {
+                        self.done = true;
+                        return Err(error.into());
+                    }
+                    Some(Ok(region)) => self.generators.begin_region(region),
+                },
+            }
+        }
+    }
