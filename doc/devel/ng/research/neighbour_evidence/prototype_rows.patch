 #[cfg(test)]
 mod tests;
+
+/// **Prototype (branch `neighbour-hmm`), not for merge.** When `PVC_PROTOTYPE_ROWS` names a file,
+/// every assembled record appends one tab-separated line to it: contig index, start, end, locus
+/// kind, the candidate alleles (`-` for an empty one), the per-sample reads, the `FILTER`, the
+/// site quality, then one field per sample — `.` for a sample set aside, otherwise its
+/// natural-log genotype likelihoods in VCF order and its leave-one-out allele concentration,
+/// `;`-separated, the two lists joined by `|`. Records arrive from several workers, so the
+/// lines are in no particular order.
+fn write_prototype_rows(locus: &LocusInference, evidence: &LocusEvidenceForOutput) {
+    use std::io::Write as _;
+    use std::sync::{Mutex, OnceLock};
+    static SINK: OnceLock<Option<Mutex<std::io::BufWriter<std::fs::File>>>> = OnceLock::new();
+    let sink = SINK.get_or_init(|| {
+        std::env::var_os("PVC_PROTOTYPE_ROWS").map(|path| {
+            Mutex::new(std::io::BufWriter::new(
+                std::fs::File::create(path).expect("the prototype rows file can be created"),
+            ))
+        })
+    });
+    let Some(sink) = sink else { return };
+    let joined = |values: &[f64]| {
+        values
+            .iter()
+            .map(|value| format!("{value:.4}"))
+            .collect::<Vec<_>>()
+            .join(";")
+    };
+    let kind = match locus.alleles().kind() {
+        LocusKind::Generic => "G",
+        LocusKind::Ssr(_) => "S",
+        LocusKind::SsrBundle(_) => "B",
+    };
+    let alleles = locus
+        .alleles()
+        .iter()
+        .map(|bases| {
+            if bases.is_empty() {
+                "-".to_string()
+            } else {
+                String::from_utf8_lossy(bases).into_owned()
+            }
+        })
+        .collect::<Vec<_>>()
+        .join(",");
+    let depths = evidence
+        .samples
+        .iter()
+        .map(|sample| {
+            (sample.allele_reads.iter().sum::<u32>() + sample.reads_no_written_allele_explains)
+                .to_string()
+        })
+        .collect::<Vec<_>>()
+        .join(",");
+    let mut line = format!(
+        "{}\t{}\t{}\t{kind}\t{alleles}\t{depths}\t{}\t{}",
+        locus.region.contig.get(),
+        locus.region.start.get(),
+        locus.region.end.get(),
+        evidence.filter.as_str(),
+        evidence.corrected_site_quality.get(),
+    );
+    for rows in &locus.prototype_rows {
+        line.push('\t');
+        match rows {
+            None => line.push('.'),
+            Some((likelihoods, concentration)) => {
+                line.push_str(&joined(likelihoods));
+                line.push('|');
+                line.push_str(&joined(concentration));
+            }
+        }
+    }
+    line.push('\n');
+    let mut writer = sink.lock().expect("the prototype rows lock is not poisoned");
+    writer
+        .write_all(line.as_bytes())
+        .expect("the prototype rows file takes a write");
+    writer.flush().expect("the prototype rows file flushes");
+}
