 use rayon::prelude::*;
 
+/// DIAGNOSTIC (not for commit): which stage the round loop is in, and samples done drawing.
+pub static DIAG_PHASE: std::sync::atomic::AtomicU64 = std::sync::atomic::AtomicU64::new(0);
+pub static DIAG_DRAWN: std::sync::atomic::AtomicU64 = std::sync::atomic::AtomicU64::new(0);
+pub static DIAG_AT: std::sync::atomic::AtomicU64 = std::sync::atomic::AtomicU64::new(0);
+
+fn diag_rss_gb() -> f64 {
+    std::fs::read_to_string("/proc/self/statm")
+        .ok()
+        .and_then(|statm| statm.split_whitespace().nth(1)?.parse::<u64>().ok())
+        .map_or(0.0, |pages| pages as f64 * 4096.0 / 1e9)
+}
+
+fn diag_start_watchdog() {
+    static STARTED: std::sync::Once = std::sync::Once::new();
+    STARTED.call_once(|| {
+        std::thread::spawn(|| loop {
+            std::thread::sleep(std::time::Duration::from_millis(500));
+            let rss = diag_rss_gb();
+            if rss > 45.0 {
+                let phase = match DIAG_PHASE.load(std::sync::atomic::Ordering::Relaxed) {
+                    1 => "fold",
+                    2 => "evict",
+                    3 => "cover",
+                    4 => "build",
+                    _ => "other",
+                };
+                eprintln!(
+                    "DIAG watchdog rss_gb={rss:.1} phase={phase} round_at={} samples_drawn={}",
+                    DIAG_AT.load(std::sync::atomic::Ordering::Relaxed),
+                    DIAG_DRAWN.load(std::sync::atomic::Ordering::Relaxed)
+                );
+            }
+        });
+    });
+}
